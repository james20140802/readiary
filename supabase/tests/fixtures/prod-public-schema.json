    ],
    "entries": [
      ["entries_content_check","c","CHECK (((quote IS NOT NULL) OR (note IS NOT NULL)))"],
      ["entries_page_order_check","c","CHECK (((from_page IS NULL) OR (to_page IS NULL) OR (from_page <= to_page)))"],
      ["fk_user_book_id","f","FOREIGN KEY (user_book_id) REFERENCES user_books(id) ON DELETE CASCADE"],
      ["entries_pkey","p","PRIMARY KEY (id)"]
    ],
    "entry_reflections": [
      ["entry_reflections_body_check","c","CHECK ((((char_length(btrim(body)) >= 1) AND (char_length(btrim(body)) <= 10000)) AND (body !~ '^[[:space:]]*$'::text)))"],
      ["entry_reflections_entry_id_fkey","f","FOREIGN KEY (entry_id) REFERENCES entries(id) ON DELETE CASCADE"],
      ["entry_reflections_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"],
      ["entry_reflections_pkey","p","PRIMARY KEY (id)"]
    ],
    "feature_rollouts": [
      ["feature_rollouts_percentage_check","c","CHECK (((percentage >= 0) AND (percentage <= 100)))"],
      ["feature_rollouts_pkey","p","PRIMARY KEY (key)"]
    ],
    "friends": [
      ["friends_status_check","c","CHECK ((status = ANY (ARRAY['pending'::text, 'accepted'::text])))"],
      ["friends_friend_id_fkey","f","FOREIGN KEY (friend_id) REFERENCES profiles(id) ON DELETE CASCADE"],
      ["friends_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"],
      ["friends_pkey","p","PRIMARY KEY (id)"]
    ],
    "likes": [
      ["fk_likes_entry_id","f","FOREIGN KEY (entry_id) REFERENCES entries(id) ON DELETE CASCADE"],
      ["fk_likes_user_id","f","FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"],
      ["likes_pkey","p","PRIMARY KEY (id)"],
      ["likes_user_entry_unique","u","UNIQUE (user_id, entry_id)"]
    ],
    "notifications": [
      ["notifications_type_check","c","CHECK ((type = ANY (ARRAY['friend_request'::text, 'friend_accept'::text, 'like'::text, 'comment'::text])))"],
      ["notifications_actor_id_fkey","f","FOREIGN KEY (actor_id) REFERENCES profiles(id) ON DELETE CASCADE"],
