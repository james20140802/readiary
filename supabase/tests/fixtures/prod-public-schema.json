      ["notifications_friendship_id_fkey","f","FOREIGN KEY (friendship_id) REFERENCES friends(id) ON DELETE CASCADE"],
      ["notifications_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"],
      ["notifications_pkey","p","PRIMARY KEY (id)"]
    ],
    "profiles": [
      ["profiles_avatar_owned_path","c","CHECK (((profile_image IS NULL) OR ((split_part(profile_image, '/'::text, 1) = (id)::text) AND (profile_image ~ '^[0-9a-fA-F-]{36}/[a-zA-Z0-9_-]+\\.(jpe?g|png|webp)$'::text))))"],
      ["profiles_bookmark_user_book_id_fkey","f","FOREIGN KEY (bookmark_user_book_id) REFERENCES user_books(id) ON DELETE SET NULL"],
      ["profiles_featured_entry_id_fkey","f","FOREIGN KEY (featured_entry_id) REFERENCES entries(id) ON DELETE SET NULL"],
