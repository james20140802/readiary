    ],
    "push_deliveries": [
      ["push_deliveries_status_check","c","CHECK ((status = ANY (ARRAY['claimed'::text, 'sent'::text, 'failed'::text, 'cancelled'::text])))"],
      ["push_deliveries_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"],
      ["push_deliveries_pkey","p","PRIMARY KEY (id)"]
    ],
    "push_finished_receipts": [
      ["push_finished_receipts_user_book_id_fkey","f","FOREIGN KEY (user_book_id) REFERENCES user_books(id) ON DELETE CASCADE"],
      ["push_finished_receipts_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"],
      ["push_finished_receipts_pkey","p","PRIMARY KEY (user_id, user_book_id)"]
    ],
    "push_preferences": [
      ["push_preferences_hour_check","c","CHECK (((hour >= 9) AND (hour <= 21)))"],
      ["push_preferences_kinds_check","c","CHECK ((kinds <@ ARRAY['reminder'::text, 'finished'::text, 'weekly'::text, 'recall'::text, 'friends'::text]))"],
      ["push_preferences_weekdays_check","c","CHECK ((((cardinality(weekdays) >= 1) AND (cardinality(weekdays) <= 7)) AND (weekdays <@ ARRAY[0, 1, 2, 3, 4, 5, 6])))"],
      ["push_preferences_user_id_fkey","f","FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"],
